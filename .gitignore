# Dependencies
node_modules/
dist/
build/
.turbo/
coverage/
*.tsbuildinfo

# pipelines/ is a plain (non-outDir) TS project — its compiled output is
# colocated with sources so packages/worker's runtime relative `require`
# resolves it directly; ignore the generated artifacts, not the sources.
pipelines/**/*.js
pipelines/**/*.js.map
pipelines/**/*.d.ts
pipelines/**/*.d.ts.map

# Env
.env
.env.*
!.env.example
!infra/temporal/.env

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# Temporal / infra local state
infra/temporal/data/
*.pid

# Artifacts produced by runs (local dev)
artifacts/
tmp/

# Playwright MCP session output (screenshots/snapshots) — never committed as-is;
# curated evidence lives under docs/evidence/ instead.
.playwright-mcp/
**/.playwright-mcp/
