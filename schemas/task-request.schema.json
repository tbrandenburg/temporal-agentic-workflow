{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "format": "ulid",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{25}$"
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "task_class": {
      "type": "string",
      "enum": [
        "feature",
        "bugfix",
        "refactor",
        "chore"
      ]
    },
    "instruction": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "requested_model": {
      "type": "string",
      "minLength": 1
    },
    "allowed_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 60,
      "maximum": 3600
    }
  },
  "required": [
    "repository",
    "task_class",
    "instruction"
  ],
  "additionalProperties": false
}
