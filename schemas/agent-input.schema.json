{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "planner",
        "coder",
        "reviewer"
      ]
    },
    "context": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "task_class": {
          "type": "string",
          "enum": [
            "feature",
            "bugfix",
            "refactor",
            "chore"
          ]
        },
        "instruction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "requested_model": {
          "type": "string",
          "minLength": 1
        },
        "allowed_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "run_id",
        "repository",
        "task_class",
        "instruction"
      ],
      "additionalProperties": false
    },
    "upstream": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "run_id": {
                "type": "string",
                "minLength": 1
              },
              "agent": {
                "type": "string",
                "enum": [
                  "planner",
                  "coder",
                  "reviewer"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "success",
                  "failure"
                ]
              },
              "summary": {
                "type": "string",
                "maxLength": 2048
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "artifact_refs": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^artifact:\\/\\/runs\\/[^/]+\\/[^/]+\\/[^/]+$"
                }
              },
              "metrics": {
                "type": "object",
                "properties": {
                  "started_at": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                  },
                  "ended_at": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                  },
                  "duration_ms": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "exit_code": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "started_at",
                  "ended_at",
                  "duration_ms",
                  "exit_code"
                ],
                "additionalProperties": false
              },
              "error": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "minLength": 1
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "message"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "run_id",
              "agent",
              "status",
              "summary",
              "confidence",
              "artifact_refs",
              "metrics"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "run_id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "passed",
                  "failed"
                ]
              },
              "steps": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "enum": [
                        "apply",
                        "allowlist",
                        "format",
                        "lint",
                        "test",
                        "secret-scan"
                      ]
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "passed",
                        "failed"
                      ]
                    },
                    "duration_ms": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "output_ref": {
                      "type": "string",
                      "pattern": "^artifact:\\/\\/runs\\/[^/]+\\/[^/]+\\/[^/]+$"
                    }
                  },
                  "required": [
                    "name",
                    "status",
                    "duration_ms"
                  ],
                  "additionalProperties": false
                }
              },
              "violations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "step": {
                      "type": "string",
                      "enum": [
                        "apply",
                        "allowlist",
                        "format",
                        "lint",
                        "test",
                        "secret-scan"
                      ]
                    },
                    "severity": {
                      "type": "string",
                      "enum": [
                        "warning",
                        "error"
                      ]
                    },
                    "message": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "step",
                    "severity",
                    "message"
                  ],
                  "additionalProperties": false
                }
              },
              "artifact_refs": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^artifact:\\/\\/runs\\/[^/]+\\/[^/]+\\/[^/]+$"
                }
              }
            },
            "required": [
              "run_id",
              "status",
              "steps",
              "violations",
              "artifact_refs"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "role",
    "context"
  ],
  "additionalProperties": false
}
