{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "passed",
        "failed"
      ]
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "apply",
              "allowlist",
              "format",
              "lint",
              "test",
              "secret-scan"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed"
            ]
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "output_ref": {
            "type": "string",
            "pattern": "^artifact:\\/\\/runs\\/[^/]+\\/[^/]+\\/[^/]+$"
          }
        },
        "required": [
          "name",
          "status",
          "duration_ms"
        ],
        "additionalProperties": false
      }
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step": {
            "type": "string",
            "enum": [
              "apply",
              "allowlist",
              "format",
              "lint",
              "test",
              "secret-scan"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "warning",
              "error"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "step",
          "severity",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "artifact_refs": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^artifact:\\/\\/runs\\/[^/]+\\/[^/]+\\/[^/]+$"
      }
    }
  },
  "required": [
    "run_id",
    "status",
    "steps",
    "violations",
    "artifact_refs"
  ],
  "additionalProperties": false
}
