# Phase 1 — pinned image versions.
#
# DEVIATION FROM PLAN (documented, see handoff): PLAN.md §4.1 specifies
# temporalio/auto-setup:1.31.2, but Docker Hub has never published that tag —
# temporalio/auto-setup tops out at 1.29.7 (verified 2026-09-09 via Docker Hub
# API). This mirrors the plan's own finding #7 that the upstream reference
# compose lags behind server releases. We pin to the newest auto-setup image
# that actually exists (1.29.7) and pair admin-tools to the same server
# version for compatibility, rather than pinning a version that doesn't exist.
POSTGRES_IMAGE=postgres:16-alpine
TEMPORAL_IMAGE=temporalio/auto-setup:1.29.7
TEMPORAL_UI_IMAGE=temporalio/ui:2.53.3
TEMPORAL_ADMIN_TOOLS_IMAGE=temporalio/admin-tools:1.29.7-tctl-1.18.4-cli-1.7.2
MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z

POSTGRES_USER=temporal
POSTGRES_PASSWORD=temporal
POSTGRES_DB=temporal

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
